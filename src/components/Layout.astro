---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
}

const { title, description, keywords, ogType, structuredData, image } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogType={ogType}
  structuredData={structuredData}
  image={image}
>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
