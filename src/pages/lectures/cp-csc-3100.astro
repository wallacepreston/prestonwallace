                      {slide.kind === 'fence' ? (
                        <div class="fence-panels">
                          <img src="/img/lectures/lara-nichols/ai-fence-1.jpeg" alt="A person paints a fence, leaving an unpainted patch, while AI watches" loading="eager" />
                          <img src="/img/lectures/lara-nichols/ai-fence-2.jpeg" alt="The person hands the paintbrush to AI and points down the fence" loading="eager" />
