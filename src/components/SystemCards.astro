---
interface SystemCard {
  id?: string;
  title: string;
  problem: string;
  type: string;
  architecture: string;
  metric?: string;
  outcomes: string[];
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
  diagram?: string;
}

interface Props {
  systems: SystemCard[];
}

const { systems } = Astro.props;
const hasDiagrams = systems.some((system) => Boolean(system.diagram));
---

<div class="system-accordion" data-system-accordion>
  {systems.map((system, index) => (
    <article
      id={system.id ?? `system-${index + 1}`}
      class="system-accordion__item"
      data-accordion-item
      data-open="false"
    >
      <button
        class="system-accordion__summary"
        type="button"
        aria-expanded="false"
        aria-controls={`system-panel-${index}`}
        data-accordion-trigger
      >
        <span class="system-accordion__index">{String(index + 1).padStart(2, '0')}</span>
        <span class="system-accordion__heading">
          <span>{system.type}</span>
          <strong>{system.title}</strong>
        </span>
        <span class="system-accordion__metric">{system.metric ?? system.outcomes[0]}</span>
        <i class="fa fa-angle-down" aria-hidden="true"></i>
      </button>

      <div
        id={`system-panel-${index}`}
        class="system-accordion__body"
        aria-hidden="true"
        data-accordion-body
      >
        <div class="system-accordion__body-inner">
          <div class:list={['system-accordion__content', { 'system-accordion__content--visual': system.image || system.diagram }]}>
            <div>
              <dl>
                <div>
                  <dt>Business problem</dt>
                  <dd>{system.problem}</dd>
                </div>
                <div>
                  <dt>System type</dt>
                  <dd>{system.type}</dd>
                </div>
                <div>
                  <dt>Architecture category</dt>
                  <dd>{system.architecture}</dd>
                </div>
              </dl>

              {system.details && (
                <ul class="system-detail-list">
                  {system.details.map((detail) => <li>{detail}</li>)}
                </ul>
              )}

              <ul class="outcome-list">
                {system.outcomes.map((outcome) => <li>{outcome}</li>)}
              </ul>

              {system.href && (
                <a class="button button-primary system-accordion__link" href={system.href}>
                  View full case study
                  <i class="fa fa-arrow-right" aria-hidden="true"></i>
                </a>
              )}
            </div>

            {(system.image || system.diagram) && system.href && (
              <a class="system-accordion__preview" href={system.href} aria-label={`View ${system.title} case study`}>
                {system.image ? (
                  <img src={system.image} alt={system.imageAlt ?? ''} loading="lazy" />
                ) : (
                  <div class="system-accordion__diagram" aria-hidden="true">
                    <pre class="mermaid">{system.diagram}</pre>
                  </div>
                )}
                <span>Explore project <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
  ))}
</div>

<script is:inline>
  document.querySelectorAll('[data-system-accordion]').forEach((accordion) => {
    const setItemOpen = (item, isOpen) => {
      const trigger = item?.querySelector('[data-accordion-trigger]');
      const body = item?.querySelector('[data-accordion-body]');

      if (!item || !trigger || !body) return;

      item.dataset.open = String(isOpen);
      trigger.setAttribute('aria-expanded', String(isOpen));
      body.setAttribute('aria-hidden', String(!isOpen));
    };

    accordion.querySelectorAll('[data-accordion-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-accordion-item]');
        const isOpen = item?.dataset.open === 'true';

        if (!item) return;

        setItemOpen(item, !isOpen);
      });
    });

    const openHashTarget = () => {
      if (!window.location.hash) return;

      const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      const item = target?.matches('[data-accordion-item]')
        ? target
        : target?.closest('[data-accordion-item]');

      if (item) setItemOpen(item, true);
    };

    window.addEventListener('hashchange', openHashTarget);
    openHashTarget();
  });
</script>

{hasDiagrams && (
  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    mermaid.initialize({
      startOnLoad: true,
      securityLevel: 'strict',
      theme: 'base',
      flowchart: { curve: 'basis', htmlLabels: true },
      themeVariables: {
        background: '#10121b',
        primaryColor: '#10282d',
        primaryTextColor: '#f5f6fb',
        primaryBorderColor: '#1df9f8',
        secondaryColor: '#151825',
        secondaryTextColor: '#f5f6fb',
        secondaryBorderColor: '#1f6f73',
        tertiaryColor: '#090a10',
        tertiaryTextColor: '#f5f6fb',
        tertiaryBorderColor: '#202437',
        lineColor: '#19c4bd',
        textColor: '#f5f6fb',
        mainBkg: '#10282d',
        nodeBorder: '#1df9f8',
        clusterBkg: '#090f16',
        clusterBorder: '#1f6f73',
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
      },
    });
  </script>
)}
