                    {['42 18 562 497', '620 18 565 497', '42 529 562 466', '620 529 565 466', '42 1007 562 486', '620 1007 565 486'].map(viewBox => <div class="genie-panel"><svg viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true"><image href={`/img/lectures/lara-nichols/${visualFor(slide).file}`} width="1224" height="1536" /></svg></div>)}
