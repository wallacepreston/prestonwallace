  </main>
  <p class="deck-help">Use ← / → to navigate, P to present, Esc to exit.{showPresenterNotes && ' N opens speaker notes.'}</p>
  <p class="deck-message" role="status" data-message></p>
  <script>
    const frames = Array.from(
      document.querySelectorAll<HTMLElement>("[data-slide]")
    )
    const progress = document.querySelector<HTMLElement>("[data-progress]")
    const presentButton =
      document.querySelector<HTMLButtonElement>("[data-present]")
    const notesButton = document.querySelector<HTMLButtonElement>("[data-notes]")
    const previousButton = document.querySelector<HTMLButtonElement>("[data-prev]")
    const nextButton = document.querySelector<HTMLButtonElement>("[data-next]")
    const fullscreenButton =
      document.querySelector<HTMLButtonElement>("[data-fullscreen]")
    const presenter =
      import.meta.env.DEV && new URLSearchParams(location.search).has("presenter")
    const sessionUrl = new URL(location.href)
    const session = sessionUrl.searchParams.get("session") ?? crypto.randomUUID()
    sessionUrl.searchParams.set("session", session)
    history.replaceState(null, "", sessionUrl)
    const channel =
      typeof BroadcastChannel === "undefined"
        ? null
        : new BroadcastChannel(`lara-nichols-${session}`)
    document.body.classList.toggle("presenter-view", presenter)
    document
      .querySelectorAll<HTMLElement>(
        ".presenter-info, [data-open-slides], [data-print-notes]"
      )
      .forEach(element => (element.hidden = !presenter))
    const announce = () => channel?.postMessage({ type: "slide", index: current })
    let current = 0
    let presenting = false
    let showNotes = false
    const update = () => {
      frames.forEach((frame, index) => {
        frame.classList.toggle("is-current", index === current)
        if (index !== current)
          frame.querySelectorAll("video").forEach(video => video.pause())
      })
      const upNext = document.querySelector("[data-up-next]")
      if (upNext)
        upNext.textContent = `Up next: ${
          frames[current + 1]?.querySelector("h1, h2")?.textContent ??
          "End of lecture"
        }`
      if (progress) progress.textContent = `${current + 1} / ${frames.length}`
      if (previousButton) previousButton.disabled = current === 0
      if (nextButton) nextButton.disabled = current === frames.length - 1
    }
    const navigate = (index: number, broadcast = true) => {
      current = Math.max(0, Math.min(frames.length - 1, index))
      update()
      history.replaceState(null, "", `#${frames[current].id}`)
      frames[current].scrollIntoView({ behavior: "instant", block: "start" })
      if (broadcast) announce()
    }
    const readHash = () => {
      const index = frames.findIndex(frame => `#${frame.id}` === location.hash)
      if (index >= 0) {
        current = index
        update()
      }
    }
    const setPresenting = (enabled: boolean) => {
      if (!enabled && document.fullscreenElement) void document.exitFullscreen()
      presenting = enabled
      document.body.classList.toggle("presenting", enabled)
      presentButton?.setAttribute("aria-pressed", String(enabled))
      if (presentButton)
        presentButton.textContent = enabled ? "All slides" : "Present"
      navigate(current, false)
    }
    const toggleNotes = () => {
      if (!import.meta.env.DEV) return
      showNotes = !showNotes
      document.querySelectorAll<HTMLElement>(".speaker-notes").forEach(note => {
        note.hidden = !showNotes
      })
      notesButton?.setAttribute("aria-pressed", String(showNotes))
    }
    if (channel) {
      channel.onmessage = event => {
        const message = event.data
        if (message?.type === "ready" && !presenter) announce()
        if (
          message?.type === "slide" &&
          Number.isInteger(message.index) &&
          message.index >= 0 &&
          message.index < frames.length
        )
          navigate(message.index, false)
      }
    }
    const openView = (speaker: boolean) => {
      if (speaker && !import.meta.env.DEV) return
      const url = new URL(location.href)
      url.searchParams.delete("presenter")
      url.searchParams.delete("present")
      url.searchParams.set(speaker ? "presenter" : "present", "1")
      url.hash = frames[current].id
      window.open(url, `lara-${session}-${speaker ? "presenter" : "audience"}`)
    }
    document
      .querySelector("[data-presenter]")
      ?.addEventListener("click", () => openView(true))
    document
      .querySelector("[data-open-slides]")
      ?.addEventListener("click", () => openView(false))
    document.querySelector("[data-print-notes]")?.addEventListener("click", () => {
      document.body.classList.add("printing-notes")
      window.print()
    })
    window.addEventListener("afterprint", () =>
      document.body.classList.remove("printing-notes")
    )
    previousButton?.addEventListener("click", () => navigate(current - 1))
    nextButton?.addEventListener("click", () => navigate(current + 1))
    presentButton?.addEventListener("click", () => setPresenting(!presenting))
    notesButton?.addEventListener("click", toggleNotes)
    document
      .querySelector("[data-print]")
      ?.addEventListener("click", () => window.print())
    document
      .querySelector("[data-fullscreen]")
      ?.addEventListener("click", async () => {
        try {
          if (document.fullscreenElement) await document.exitFullscreen()
          else {
            setPresenting(true)
            await document.documentElement.requestFullscreen()
          }
        } catch {
          const message = document.querySelector("[data-message]")
          if (message)
            message.textContent =
              "Fullscreen is unavailable here. Presentation mode is still available."
        }
      })
    document.addEventListener("fullscreenchange", () => {
      const fullscreen = Boolean(document.fullscreenElement)
      document.body.classList.toggle("deck-fullscreen", fullscreen)
      if (fullscreen) {
        document
          .querySelector<HTMLElement>(".lecture-deck")
          ?.focus({ preventScroll: true })
        const message = document.querySelector("[data-message]")
        if (message) message.textContent = ""
      }
      if (fullscreenButton) {
        fullscreenButton.textContent = fullscreen ? "Exit fullscreen" : "Fullscreen"
        fullscreenButton.setAttribute("aria-pressed", String(fullscreen))
      }
      navigate(current)
    })
    window.addEventListener("hashchange", readHash)
    document.addEventListener("keydown", event => {
      if (
        event.target instanceof Element &&
        event.target.closest("input, textarea, select, [contenteditable]")
      )
        return
      if (
        ["ArrowRight", "PageDown", "ArrowLeft", "PageUp", "Home", "End"].includes(
          event.key
        )
      )
        event.preventDefault()
      if (["ArrowRight", "PageDown"].includes(event.key)) navigate(current + 1)
      if (["ArrowLeft", "PageUp"].includes(event.key)) navigate(current - 1)
      if (event.key === "Home") navigate(0)
      if (event.key === "End") navigate(frames.length - 1)
      if (event.key.toLowerCase() === "p") setPresenting(!presenting)
      if (event.key.toLowerCase() === "n") toggleNotes()
      if (event.key === "Escape") setPresenting(false)
    })
    const observer = new IntersectionObserver(
      entries => {
        if (presenting || presenter) return
        const visible = entries
          .filter(entry => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
        if (visible) {
          current = frames.indexOf(visible.target as HTMLElement)
          update()
          announce()
        }
      },
      { threshold: [0.5, 0.75] }
    )
    frames.forEach(frame => observer.observe(frame))
    readHash()
    if (presenter) toggleNotes()
    if (presenter || new URLSearchParams(location.search).has("present"))
      setPresenting(true)
    update()
    if (presenter) channel?.postMessage({ type: "ready" })
    const animationButton =
      document.querySelector<HTMLButtonElement>("[data-animation]")
    const animation = animationButton?.closest("figure")?.querySelector("img")
    let animationPaused = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches
    const paintAnimation = () => {
      if (animation)
        animation.src = `/img/lectures/lara-nichols/${
          animationPaused ? "workflow-still.png" : "supplied-animation.gif"
        }`
      if (animationButton) {
        animationButton.textContent = animationPaused
          ? "Play animation"
          : "Pause animation"
        animationButton.setAttribute("aria-pressed", String(animationPaused))
      }
    }
    animationButton?.addEventListener("click", () => {
      animationPaused = !animationPaused
      paintAnimation()
    })
    paintAnimation()
    let remaining = 600
    let deadline = 0
    let ticker: ReturnType<typeof setInterval> | undefined
    const timer = document.querySelector<HTMLOutputElement>("[data-timer]")
    const start = document.querySelector<HTMLButtonElement>("[data-timer-start]")
    const status = document.querySelector<HTMLElement>("[data-timer-status]")
    const paintTimer = () => {
      if (timer)
        timer.textContent = `${Math.floor(remaining / 60)}:${String(
          remaining % 60
        ).padStart(2, "0")}`
    }
    const pause = () => {
      if (ticker !== undefined) clearInterval(ticker)
      ticker = undefined
      if (start)
        start.textContent = remaining === 0 ? "Restart timer" : "Resume timer"
    }
    start?.addEventListener("click", () => {
      if (ticker !== undefined) {
        remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000))
        pause()
        paintTimer()
        if (status) status.textContent = "Paused"
        return
      }
      if (remaining === 0) remaining = 600
      deadline = Date.now() + remaining * 1000
      start.textContent = "Pause timer"
      if (status) status.textContent = "Pair work in progress"
      ticker = setInterval(() => {
        remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000))
        paintTimer()
        if (remaining === 0) {
          pause()
          if (status) status.textContent = "Time to compare your evidence"
        }
      }, 250)
    })
    document.querySelector("[data-timer-reset]")?.addEventListener("click", () => {
      pause()
      remaining = 600
      paintTimer()
      if (start) start.textContent = "Start timer"
      if (status) status.textContent = "Ready for pair work"
    })
  </script>
</BaseLayout>

