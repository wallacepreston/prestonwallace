---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.publishedAt);
const keywords = [
  'AI engineering',
  'generative AI',
  'GenAI',
  'full-stack AI',
  'LLM applications',
  'RAG',
  'AI agents',
  'AI evals',
  'LLM evaluation',
  'React',
  'TypeScript',
  'Node.js',
  'GraphQL',
  'cloud architecture',
];
const postUrl = new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url.origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  mainEntityOfPage: postUrl,
  author: {
    '@type': 'Person',
    name: 'Preston Wallace',
    url: 'https://prestonwallace.com/',
    jobTitle: 'Full-Stack AI Software Engineer',
  },
  publisher: {
    '@type': 'Person',
    name: 'Preston Wallace',
  },
  image: new URL(post.data.image, Astro.site ?? Astro.url.origin).toString(),
  keywords,
};
---

<Layout
  title={`${post.data.title} | Preston Wallace`}
  description={post.data.description}
  keywords={keywords}
  ogType="article"
  structuredData={structuredData}
  image={post.data.image}
>
  <article class="blog-post">
    <div class="blog-container">
      <a class="blog-back" href="/blog/">← All posts</a>

      <header class="blog-post__header">
        <p class="eyebrow">Blog</p>
        <h1 id={post.id}>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <time datetime={post.data.publishedAt.toISOString()}>{formattedDate}</time>
      </header>

      <figure class="blog-post__hero-image">
        <img src={post.data.image} alt={post.data.imageAlt} width="1200" height="630" />
      </figure>

      <div class="blog-post__body">
        <Content />
      </div>
    </div>
  </article>

  <script is:inline>
    const copyText = async (value) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return;
      }

      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
    };

    document.querySelectorAll('.blog-post h1, .blog-post h2, .blog-post h3, .blog-post h4, .blog-post h5, .blog-post h6').forEach((heading) => {
      if (!heading.id) return;

      heading.classList.add('linkable-heading');

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'heading-link';
      button.setAttribute('aria-label', `Copy link to ${heading.textContent.trim()}`);
      button.title = 'Copy link to this section';
      button.innerHTML = '<i class="fa fa-link" aria-hidden="true"></i>';
      heading.appendChild(button);

      const copyHeadingLink = async () => {
        const url = new URL(window.location.href);
        url.hash = heading.id;

        window.history.replaceState(null, '', url.toString());
        heading.scrollIntoView({ behavior: 'smooth', block: 'start' });

        try {
          await copyText(url.toString());
          const icon = button.querySelector('i');
          icon.className = 'fa fa-check';
          button.classList.add('heading-link--copied');
          button.setAttribute('aria-label', 'Link copied');
          button.title = 'Link copied';

          window.setTimeout(() => {
            icon.className = 'fa fa-link';
            button.classList.remove('heading-link--copied');
            button.setAttribute('aria-label', `Copy link to ${heading.textContent.trim()}`);
            button.title = 'Copy link to this section';
          }, 1600);
        } catch (error) {
          console.error('Unable to copy heading link', error);
        }
      };

      heading.addEventListener('click', copyHeadingLink);
    });
  </script>

  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    mermaid.initialize({
      startOnLoad: true,
      securityLevel: 'strict',
      theme: 'base',
      flowchart: {
        curve: 'basis',
        htmlLabels: true,
        nodeSpacing: 60,
        rankSpacing: 60,
        padding: 28,
      },
      themeVariables: {
        background: '#10121b',
        primaryColor: '#10282d',
        primaryTextColor: '#f5f6fb',
        primaryBorderColor: '#1df9f8',
        secondaryColor: '#151825',
        secondaryTextColor: '#f5f6fb',
        secondaryBorderColor: '#1f6f73',
        tertiaryColor: '#090a10',
        tertiaryTextColor: '#f5f6fb',
        tertiaryBorderColor: '#202437',
        lineColor: '#19c4bd',
        textColor: '#f5f6fb',
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
      },
    });
  </script>
</Layout>
