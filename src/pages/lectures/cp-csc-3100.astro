                {slide.explore && <div class="slide-explore">{slide.explore.map(item => <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label} <span aria-hidden="true">↗</span></a>)}</div>}
                {slide.link && <a class="video-link" href={slide.link} target="_blank" rel="noopener noreferrer">{slide.linkLabel} <span aria-hidden="true">↗</span></a>}
              </div>
            </>
          )}
          <footer class="folio"><span>Building Software with AI</span><span>{String(index + 1).padStart(2, '0')} / {slides.length}</span></footer>
        </section>
        {showPresenterNotes && <aside class="speaker-notes" aria-label={`Speaker notes for slide ${index + 1}`} hidden>
          <h3>Speaker notes · {slide.time}</h3>
          {slide.notes.activation && <section class="activation-cue" aria-label="Activate prior knowledge"><strong>Activate prior knowledge</strong><p>{slide.notes.activation}</p></section>}
