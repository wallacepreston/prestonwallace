                      ) : <img src={`/img/lectures/lara-nichols/${visualFor(slide).file}`} alt={visualFor(slide).alt} loading="eager" />}
                      {slide.kind === 'steps' && <button type="button" class="animation-toggle" data-animation aria-pressed="false">Pause animation</button>}
                      <figcaption class="sr-only">{visualFor(slide).credit}</figcaption>
                    </figure>
                  </div>
                ) : slide.kind === 'sdlc' ? (
                  <ol class="lifecycle">{slide.points?.map((point, step) => <li><span>{String(step + 1).padStart(2, '0')}</span>{point}</li>)}</ol>
                  <p class="annotation">Observe the result. Revise the requirements. Repeat.</p>
                ) : slide.kind === 'stack' ? (
                  <ol class="stack-path">{slide.points?.map(point => <li>{point}</li>)}</ol>
                  <div class="logic"><code>validEmail AND NOT alreadyRegistered</code><p>Validate on the server. Enforce uniqueness in the database.</p></div>
                ) : (
