---
const currentYear = new Date().getFullYear();
---

<footer class="footer-area">
  <div class="content-container footer-inner">
    <div class="footer-brand">
      <a class="brand brand--footer" href="/" aria-label="Preston Wallace home">
        <span class="brand__mark">
          <img src="/img/about/headshot-round.png" alt="" />
        </span>
        <span class="brand__name">Preston Wallace</span>
      </a>
      <p>
        Senior full-stack software engineer focused on scalable SaaS, AI workflows, and production
        systems that create measurable business outcomes.
      </p>
    </div>

    <div class="footer-links" aria-label="Footer navigation">
      <a href="/#capabilities">What I Do</a>
      <a href="/#systems">Portfolio</a>
      <a href="/#experience">Experience</a>
      <a href="/#process">Approach</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </div>

    <div class="footer-contact">
      <a href="mailto:wallace.preston@gmail.com">wallace.preston@gmail.com</a>
      <a class="social-button" href="https://www.linkedin.com/in/prestonwallace/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <i class="fa fa-linkedin-square" aria-hidden="true"></i>
